# ==========================================
# 额度限制配置 (单位: 字符/Token)
# ==========================================
# 单个用户每日上限 (200万)
USER_DAILY_TOKEN_LIMIT=2000000
# 单次请求最大限制 (4万)
SINGLE_REQUEST_TOKEN_LIMIT=40000
# 全平台每日总上限 (500万)
PLATFORM_DAILY_TOKEN_LIMIT=5000000
MULTIPLIER = 1.5


# ==========================================
# 其他系统配置 (可选补充)
# ==========================================
