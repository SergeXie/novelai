{
  "openapi": "3.0.3",
  "info": {
    "title": "书籍角色批量接口",
    "version": "1.0.0",
    "description": "批量新增和批量编辑书籍角色。每次最多提交100条，任意一条失败时整批回滚。"
  },
  "servers": [
    {
      "url": "/novelAI"
    }
  ],
  "tags": [
    {
      "name": "书籍角色"
    }
  ],
  "paths": {
    "/user/role/batch/add": {
      "post": {
        "tags": [
          "书籍角色"
        ],
        "summary": "批量新增角色",
        "description": "请求体直接提交角色数组。角色固定挂载到虚拟角色节点-2下，类型固定为2。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/BatchAddRoleItemReq"
                }
              },
              "example": [
                {
                  "bid": "BID20260721162403057795CBBEAE2D55F7",
                  "parent_id": -2,
                  "is_leaf": 1,
                  "name": "孔广华",
                  "data": "{\"name\":\"孔广华\",\"identity\":\"\",\"appearance\":\"\",\"motivation\":\"\",\"personality\":\"\",\"skills\":\"\",\"speechStyle\":\"\",\"baseline\":\"\",\"arc\":\"\",\"category\":\"\",\"describe\":\"\",\"attributes\":\"\"}",
                  "content": "孔广华",
                  "type": 2
                },
                {
                  "bid": "BID20260721162403057795CBBEAE2D55F7",
                  "parent_id": -2,
                  "is_leaf": 1,
                  "name": "林建国",
                  "data": "{\"name\":\"林建国\",\"identity\":\"基层公务员\",\"appearance\":\"\",\"motivation\":\"\",\"personality\":\"稳重\",\"skills\":\"\",\"speechStyle\":\"\",\"baseline\":\"\",\"arc\":\"\",\"category\":\"\",\"describe\":\"\",\"attributes\":\"\"}",
                  "content": "林建国",
                  "type": 2
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增成功，或业务校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseBatchAddRole"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessErrorResponse"
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "summary": "新增成功",
                    "value": {
                      "code": 200,
                      "msg": "Success",
                      "data": [
                        {
                          "id": 2787,
                          "bid": "BID20260721162403057795CBBEAE2D55F7",
                          "parent_id": -2,
                          "is_leaf": 1,
                          "name": "孔广华",
                          "data": {
                            "name": "孔广华",
                            "identity": ""
                          },
                          "content": "孔广华"
                        }
                      ],
                      "success": true,
                      "time": "2026-07-24 15:30:00"
                    }
                  },
                  "businessError": {
                    "summary": "业务校验失败",
                    "value": {
                      "code": 400,
                      "msg": "书籍不存在或无权操作",
                      "success": false,
                      "time": "2026-07-24 15:30:00"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/role/batch/edit": {
      "post": {
        "tags": [
          "书籍角色"
        ],
        "summary": "批量编辑角色",
        "description": "请求体直接提交角色数组。接口会校验角色ID、书籍ID、当前用户以及节点类型。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/BatchEditRoleItemReq"
                }
              },
              "example": [
                {
                  "id": 2786,
                  "bid": "BID20260721162403057795CBBEAE2D55F7",
                  "name": "孔广华22313",
                  "data": "{\"name\":\"孔广华22313\",\"identity\":\"\",\"appearance\":\"\",\"motivation\":\"\",\"personality\":\"\",\"skills\":\"\",\"speechStyle\":\"\",\"baseline\":\"\",\"arc\":\"\",\"category\":\"\",\"describe\":\"\",\"attributes\":\"\"}"
                },
                {
                  "id": 2787,
                  "bid": "BID20260721162403057795CBBEAE2D55F7",
                  "name": "林建国",
                  "data": {
                    "name": "林建国",
                    "identity": "基层公务员",
                    "personality": "稳重"
                  }
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "编辑成功，或业务校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponseBatchEditRole"
                    },
                    {
                      "$ref": "#/components/schemas/BusinessErrorResponse"
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "summary": "编辑成功",
                    "value": {
                      "code": 200,
                      "msg": "Success",
                      "data": [
                        {
                          "id": 2786,
                          "name": "孔广华22313",
                          "updateTime": "2026-07-24 15:35:00"
                        }
                      ],
                      "success": true,
                      "time": "2026-07-24 15:35:00"
                    }
                  },
                  "businessError": {
                    "summary": "业务校验失败",
                    "value": {
                      "code": 400,
                      "msg": "角色不存在或无权编辑: 2786",
                      "success": false,
                      "time": "2026-07-24 15:35:00"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RoleData": {
        "type": "object",
        "description": "角色扩展信息，字段可按业务需要增加。",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "motivation": {
            "type": "string"
          },
          "personality": {
            "type": "string"
          },
          "skills": {
            "type": "string"
          },
          "speechStyle": {
            "type": "string"
          },
          "baseline": {
            "type": "string"
          },
          "arc": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "describe": {
            "type": "string"
          },
          "attributes": {
            "type": "string"
          }
        }
      },
      "RoleDataInput": {
        "description": "兼容JSON字符串和JSON对象两种提交方式。",
        "nullable": true,
        "oneOf": [
          {
            "type": "string",
            "description": "序列化后的JSON字符串"
          },
          {
            "$ref": "#/components/schemas/RoleData"
          }
        ]
      },
      "BatchAddRoleItemReq": {
        "type": "object",
        "required": [
          "bid",
          "name"
        ],
        "properties": {
          "bid": {
            "type": "string",
            "description": "书籍业务ID"
          },
          "parent_id": {
            "type": "integer",
            "enum": [
              -2
            ],
            "default": -2,
            "description": "角色虚拟父节点ID，只能为-2"
          },
          "is_leaf": {
            "type": "integer",
            "enum": [
              1
            ],
            "default": 1,
            "description": "角色节点固定为叶子节点"
          },
          "name": {
            "type": "string",
            "description": "角色名称"
          },
          "data": {
            "$ref": "#/components/schemas/RoleDataInput"
          },
          "content": {
            "type": "string",
            "nullable": true,
            "description": "角色内容"
          },
          "type": {
            "type": "integer",
            "enum": [
              2
            ],
            "default": 2,
            "description": "角色节点类型，只能为2"
          }
        }
      },
      "BatchEditRoleItemReq": {
        "type": "object",
        "required": [
          "id",
          "bid"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "mc_book_node角色节点ID"
          },
          "bid": {
            "type": "string",
            "description": "书籍业务ID"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "角色名称"
          },
          "data": {
            "$ref": "#/components/schemas/RoleDataInput"
          }
        }
      },
      "AddRoleItemResp": {
        "type": "object",
        "required": [
          "id",
          "bid",
          "parent_id",
          "is_leaf",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "bid": {
            "type": "string"
          },
          "parent_id": {
            "type": "integer",
            "example": -2
          },
          "is_leaf": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string"
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleData"
              }
            ],
            "nullable": true
          },
          "content": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EditRoleItemResp": {
        "type": "object",
        "required": [
          "id",
          "name",
          "updateTime"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "updateTime": {
            "type": "string",
            "example": "2026-07-24 15:35:00"
          }
        }
      },
      "ApiResponseBatchAddRole": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "data",
          "success",
          "time"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "Success"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddRoleItemResp"
            }
          },
          "success": {
            "type": "boolean",
            "example": true
          },
          "time": {
            "type": "string",
            "example": "2026-07-24 15:30:00"
          }
        }
      },
      "ApiResponseBatchEditRole": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "data",
          "success",
          "time"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "Success"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EditRoleItemResp"
            }
          },
          "success": {
            "type": "boolean",
            "example": true
          },
          "time": {
            "type": "string",
            "example": "2026-07-24 15:35:00"
          }
        }
      },
      "BusinessErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "msg",
          "success",
          "time"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "nullable": true
          },
          "success": {
            "type": "boolean",
            "example": false
          },
          "time": {
            "type": "string"
          }
        }
      }
    }
  }
}
