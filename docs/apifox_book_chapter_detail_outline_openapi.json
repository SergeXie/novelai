{
  "openapi": "3.0.3",
  "info": {
    "title": "Book Chapter Detail Outline API",
    "version": "1.0.0",
    "description": "Bind or unbind a chapter and optionally generate its detailed outline with AI."
  },
  "servers": [
    {
      "url": "/novelAI"
    }
  ],
  "paths": {
    "/book/chapter/bindDetailOutline": {
      "post": {
        "summary": "Bind chapter and generate detailed outline",
        "description": "When useAiPrompt=true (default), use -7 to create a detailed-outline child and generate its content. When useAiPrompt=false, content is saved directly without an AI request. Use null to unbind.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BindChapterDetailOutlineReq" },
              "examples": {
                "create_and_generate": {
                  "value": {
                    "bid": "BID202607301000000000000000000001",
                    "chapterId": 9101,
                    "detailOutlineId": -7
                  }
                },
                "create_with_manual_content": {
                  "value": {
                    "bid": "BID202607301000000000000000000001",
                    "chapterId": 9101,
                    "detailOutlineId": -7,
                    "useAiPrompt": false,
                    "content": "第1章：主角初入公司，与直属主管发生第一次冲突。"
                  }
                },
                "unbind": {
                  "value": {
                    "bid": "BID202607301000000000000000000001",
                    "chapterId": 9101,
                    "detailOutlineId": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "msg": "Success",
                  "data": {
                    "chapterId": 9101,
                    "detailOutlineId": 9001,
                    "requestId": "REQ20260730140000ABCDEF"
                  },
                  "success": true
                }
              }
            }
          }
        }
      }
    },
    "/book/chapter/detailOutline/status": {
      "get": {
        "summary": "Query chapter detailed-outline binding status",
        "description": "Returns whether the content chapter has a valid detailed-outline binding. This endpoint does not modify data.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "bid",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "chapterId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "examples": {
                  "bound": {
                    "value": {
                      "code": 200,
                      "msg": "Success",
                      "data": {
                        "chapterId": 9101,
                        "isBound": true,
                        "detailOutlineId": 9001,
                        "detailOutlineName": "第1章：初入公司"
                      },
                      "success": true
                    }
                  },
                  "unbound": {
                    "value": {
                      "code": 200,
                      "msg": "Success",
                      "data": {
                        "chapterId": 9101,
                        "isBound": false,
                        "detailOutlineId": null,
                        "detailOutlineName": null
                      },
                      "success": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BindChapterDetailOutlineReq": {
        "type": "object",
        "required": ["bid", "chapterId"],
        "properties": {
          "bid": { "type": "string" },
          "chapterId": { "type": "integer" },
          "detailOutlineId": {
            "type": "integer",
            "nullable": true,
            "description": "Use -7 to create and generate, an existing detailed-outline item ID to bind and regenerate, or null to unbind."
          },
          "useAiPrompt": {
            "type": "boolean",
            "default": true,
            "description": "Whether to generate the detailed outline with AI. Set false to save content directly."
          },
          "content": {
            "type": "string",
            "nullable": true,
            "description": "Manual detailed-outline content. Used when useAiPrompt is false."
          }
        }
      }
    }
  }
}
