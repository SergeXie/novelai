{
  "openapi": "3.0.3",
  "info": {
    "title": "公共词条库编辑接口",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/novelAI"
    }
  ],
  "tags": [
    {
      "name": "公共词条库"
    }
  ],
  "paths": {
    "/lexicon/edit": {
      "post": {
        "tags": ["公共词条库"],
        "summary": "编辑公共词条库",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GlobalLexiconEditReq"
              },
              "example": {
                "id": 1,
                "title": "翻天印",
                "lexiconType": 4,
                "content": "上古法宝，威力极强。",
                "data": {
                  "aliases": ["番天印"],
                  "level": "神器"
                },
                "shareLevel": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGlobalLexiconItem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GlobalLexiconEditReq": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "description": "词条ID"},
          "title": {"type": "string", "minLength": 1, "maxLength": 100, "description": "词条名称"},
          "lexiconType": {"type": "integer", "minimum": 1, "maximum": 4, "description": "1角色, 2世界观, 3功法, 4道具"},
          "content": {"type": "string", "nullable": true, "description": "详细设定描述"},
          "data": {"type": "object", "nullable": true, "description": "别名、扩展属性"},
          "shareLevel": {"type": "integer", "minimum": 0, "maximum": 2, "description": "共享等级: 0私有, 1系列可见, 2全平台公开"}
        }
      },
      "GlobalLexiconItem": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "userId": {"type": "integer"},
          "title": {"type": "string"},
          "lexiconType": {"type": "integer"},
          "content": {"type": "string", "nullable": true},
          "data": {"type": "object", "nullable": true},
          "shareLevel": {"type": "integer"},
          "createTime": {"type": "string", "nullable": true, "example": "2026-06-30 18:00:00"}
        }
      },
      "ApiResponseGlobalLexiconItem": {
        "type": "object",
        "properties": {
          "code": {"type": "integer", "example": 200},
          "msg": {"type": "string", "example": "Success"},
          "data": {"$ref": "#/components/schemas/GlobalLexiconItem"},
          "success": {"type": "boolean", "example": true},
          "time": {"type": "string"}
        }
      }
    }
  }
}
